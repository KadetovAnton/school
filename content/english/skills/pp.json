{
 "topic": "pp",
 "title": "Present Perfect",
 "skills": [
  {
   "id": "pp.form",
   "title": "have / has + третя форма",
   "rule": "I / you / we / they → have; he / she / it → has; + третя форма (cleaned, seen, done, written).",
   "worked": {
    "p": "She ___ a letter to her friend. (write)",
    "steps": [
     "she → <b>has</b>.",
     "write — неправильне: write – wrote – <b>written</b>.",
     "Відповідь: She <b>has written</b> a letter."
    ]
   },
   "alt": "<p>Дві цеглинки: <b>have / has</b> + <b>третя форма</b>.</p>\n        <p>Правильні — як минуле (-ed): has clean<b>ed</b>. Неправильні — з таблиці: seen, done, eaten, written, broken.</p>\n        <p class=\"muted\">Не плутай другу і третю: I <b>saw</b> (вчора) ↔ I have <b>seen</b>.</p>",
   "items": [
    {
     "type": "choice",
     "p": "I ___ finished my homework.",
     "o": [
      "have",
      "has",
      "am"
     ],
     "a": "have",
     "h": [
      "I → have.",
      "+ третя форма."
     ],
     "e": "I <b>have</b> finished.",
     "err": {
      "has": "З I — <b>have</b>.",
      "am": "Present Perfect — з have: I <b>have</b> finished."
     }
    },
    {
     "type": "choice",
     "p": "She ___ lost her keys.",
     "o": [
      "has",
      "have"
     ],
     "a": "has",
     "h": [
      "she → has.",
      "+ третя форма."
     ],
     "e": "she <b>has</b> lost.",
     "err": {
      "have": "she → <b>has</b>."
     }
    },
    {
     "type": "choice",
     "p": "We have ___ this film.",
     "o": [
      "seen",
      "saw",
      "see"
     ],
     "a": "seen",
     "h": [
      "Після have — третя форма.",
      "see – saw – seen."
     ],
     "e": "have <b>seen</b>.",
     "err": {
      "saw": "Після have — третя форма: <b>seen</b>.",
      "see": "Після have — третя форма: <b>seen</b>."
